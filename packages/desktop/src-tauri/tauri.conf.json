{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ribbon",
  "version": "0.30.2",
  "identifier": "app.ribbon.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ribbon",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost ribbonmp3: http://ribbonmp3.localhost ribbonaudio: http://ribbonaudio.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost ribbonmp3: http://ribbonmp3.localhost ribbonaudio: http://ribbonaudio.localhost https: http://localhost:* http://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "minimumSystemVersion": "16.4",
      "frameworks": [
        "Accelerate"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQjNGNEIwQ0M0OUI2RUUKUldUdXRrbk1zUFN6dXNFUGZFOTFSb2ZxdXJEYUwzZGh1dG5FOEh1UUhoRWFTa1ZVVHdCSEh1bFUK",
      "endpoints": [
        "https://github.com/KhalidAdan/ribbon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
