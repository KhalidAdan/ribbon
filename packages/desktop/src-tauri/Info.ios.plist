<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into the iOS app's Info.plist. An audiobook plays on with
     the screen locked, as at bedtime: without the audio background mode, iOS
     suspends the app, and the book stops, the moment the phone locks. -->
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
