{
  "name": "@ribbon/server",
  "version": "0.1.0",
  "description": "Ribbon's server: the books, each person's place, for the people you invite.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "link": "tsx src/link.ts",
    "key": "tsx src/key.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.7",
    "@ribbon/auth": "*",
    "@ribbon/auth-accounts": "*",
    "@ribbon/auth-pocket-id": "*",
    "@ribbon/core": "*",
    "@ribbon/host-node": "*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
