{
  "name": "ribbon",
  "description": "A home for your books, read or heard.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ribbon/desktop --",
    "build": "npm run build -w @ribbon/desktop --",
    "preview": "npm run preview -w @ribbon/desktop --",
    "tauri": "npm run tauri -w @ribbon/desktop --",
    "tauri:dev": "npm run tauri:dev -w @ribbon/desktop --",
    "test:watch": "npm run test:watch -w @ribbon/desktop --",
    "test:rust": "npm run test:rust -w @ribbon/desktop --",
    "test": "npm test -w @ribbon/core -w @ribbon/desktop",
    "typecheck": "npm run typecheck -w @ribbon/core -w @ribbon/desktop",
    "ribbon": "tsx packages/desktop/tools/ribbon.ts",
    "fixtures": "tsx packages/desktop/tools/make-fixtures.ts",
    "shots": "tsx packages/desktop/tools/shots.ts",
    "demo-library": "tsx packages/desktop/tools/make-demo-library.ts",
    "flows": "tsx packages/desktop/tools/flows.ts",
    "e2e": "tsx packages/desktop/tools/e2e/run.ts",
    "e2e:library": "tsx packages/desktop/tools/e2e/fetch-library.ts",
    "e2e:speed-compare": "tsx packages/desktop/tools/e2e/speed-compare.ts"
  }
}
